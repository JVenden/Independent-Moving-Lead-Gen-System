# Copy to .env.local for local dev; set the same vars in Netlify. NEVER commit real values.

# --- Admin dashboard (/admin) ---
# Required in production. Log in with any username and this password.
ADMIN_PASSWORD=

# --- Storage (Supabase free tier) --- run supabase/schema.sql first
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Prospect finder (Google Places API, "Places API (New)") ---
# Google Cloud console → enable "Places API (New)" → create an API key.
# Restrict the key to that API. Set a budget alert; see README for cost notes.
GOOGLE_PLACES_API_KEY=

# --- Alerts to your phone: configure at least one ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional backup: email (or email-to-SMS gateway) via Resend
RESEND_API_KEY=
RESEND_FROM=alerts@your-verified-domain.com
ALERT_EMAIL_TO=you@example.com
