# Copy to .env.local for local dev; set the same vars in your host's dashboard.
# NEVER commit real values.

# --- Lead storage (Supabase) ---
# (NEXT_PUBLIC_SUPABASE_URL is also accepted)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dispatch alerts: configure at least one ---
# Telegram (recommended, free): create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email-to-SMS via Resend (optional backup; carrier gateways are unreliable)
RESEND_API_KEY=
RESEND_FROM=leads@your-verified-domain.com
# (FRIEND_CARRIER_GATEWAY is also accepted)
DISPATCH_SMS_GATEWAY=5551234567@vtext.com

# Business name, phone, address, review link etc. live in src/lib/business.ts
